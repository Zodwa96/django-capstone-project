# Copy this file to .env and fill in your own values:
#   cp .env.example .env        (Windows PowerShell: copy .env.example .env)
#
# .env is already listed in .gitignore, so it will never be committed.
# It is read automatically (by python-dotenv, see newsproject/settings.py)
# whether you run the project locally with a venv or with Docker Compose.

# --- Database (MariaDB/MySQL) ---
# Not needed if you set USE_SQLITE=1 instead.
DB_NAME=newsdb
DB_USER=newsapp
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=3306

# Only used by docker-compose.yml when it creates the MariaDB container.
DB_ROOT_PASSWORD=change_me_too

# Set to 1 to use a local SQLite file instead of MariaDB/MySQL
# (useful for a quick local run or for running the test suite).
USE_SQLITE=0

# --- Email (optional) ---
# Approving an article emails subscribed readers. Leave the defaults to
# just print emails to the console instead of sending real ones.
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# --- Site URL (optional) ---
SITE_URL=http://localhost:8000
